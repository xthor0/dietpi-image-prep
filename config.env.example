# Copy to config.env and edit. config.env is gitignored: it holds passwords and Wi-Fi keys.
# Everything written to the SD card is stored in plaintext on it. Treat PASSWORD as a throwaway
# and replace it (Ansible, passwd) once the board is up.

# SHA-256 of the .img.xz as published on https://dietpi.com/downloads/images/ (strongly recommended)
IMAGE_SHA256=

# --- system -----------------------------------------------------------------------------------
# (hostname is not set here: pass -n HOSTNAME to prepare-image.sh)
TIMEZONE=UTC                 # e.g. America/Denver
KEYBOARD_LAYOUT=us
# Initial password for root, the stock "dietpi" user, and USERNAME below.
PASSWORD=p@ssw0rd

# --- extra login user + SSH keys ----------------------------------------------------------------
# Leave USERNAME empty to skip creating a user (only root and "dietpi" exist then).
USERNAME=
# Space-separated URLs, tried in order; the first one that returns only valid public keys wins.
# If every URL fails the first-boot script exits non-zero and leaves /root/KEYS_FETCH_FAILED.
# e.g. "https://keys.example.com/me https://github.com/YOURUSER.keys"
SSH_KEY_URLS=
SUDO_NOPASSWD=1

# --- packages and services ------------------------------------------------------------------
# Installed after DietPi's first-run setup, before the custom script (AUTO_SETUP_APT_INSTALLS).
# DietPi ships without python3; Ansible needs it.
APT_INSTALLS="python3 sudo"
# DietPi masks systemd-logind and has no dbus. Ansible's hostname/timezone modules need them.
UNMASK_LOGIND=1
# DietPi's default SSH server is Dropbear. -2 selects OpenSSH (sshd_config.d, sshd -T).
SSH_SERVER_INDEX=-2

# --- Wi-Fi (optional) -------------------------------------------------------------------------
# With Wi-Fi on, DietPi disables Ethernet. If the board's Wi-Fi driver does not work you will have
# no network at all, so verify Wi-Fi on a test card before relying on it.
WIFI_ENABLED=0
WIFI_SSID=
WIFI_KEY=
WIFI_KEYMGR=WPA-PSK          # NONE | WPA-PSK | WEP  (WPA-EAP is not supported by this script)
WIFI_COUNTRY=US              # ISO 3166 two-letter code
